    {
      "name": "lanes_is_a_mapping",
      "why": "an empty mapping iterates as empty",
      "document": {
        "lanes": {},
        "bands": [
          {
            "band_id": "L0_B0",
            "lane_id": "L0",
            "qc_flags": []
          }
        ],
        "normalization": {
          "ratios": [
            {
              "lane_id": "L0",
              "numerator_band_id": "L0_B0",
              "excluded": false,
              "qc_flags": []
            }
          ]
        },
        "image_qc_flags": []
      },
      "python": {
        "outcome": "raises",
        "error_type": "DisplayError",
        "refuses": true
      }
    },
