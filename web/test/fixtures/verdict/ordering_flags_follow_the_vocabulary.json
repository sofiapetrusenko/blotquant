{
  "name": "ordering_flags_follow_the_vocabulary",
  "why": "flags are reported in BAND_QC_FLAGS order (saturated, overlapping, unresolved_shoulder) whatever order they arrive in, and duplicates collapse. Alphabetical order would give a different list, which is what makes this a test rather than a coincidence",
  "document": {
    "lanes": [
      {
        "lane_id": "L0",
        "roi_source": "caller"
      }
    ],
    "bands": [
      {
        "band_id": "L0_B0",
        "lane_id": "L0",
        "qc_flags": [
          "unresolved_shoulder",
          "overlapping"
        ]
      },
      {
        "band_id": "L0_B1",
        "lane_id": "L0",
        "qc_flags": [
          "saturated",
          "overlapping"
        ]
      }
    ],
    "normalization": {
      "ratios": [
        {
          "lane_id": "L0",
          "numerator_band_id": "L0_B0",
          "excluded": false,
          "qc_flags": [],
          "reference_qc_flags": []
        },
        {
          "lane_id": "L0",
          "numerator_band_id": "L0_B1",
          "excluded": true,
          "qc_flags": [],
          "reference_qc_flags": []
        }
      ]
    },
    "image_qc_flags": []
  },
  "expected": [
    {
      "lane_id": "L0",
      "roi_source": "caller",
      "verdict": "flagged",
      "qc_flags": [
        "saturated",
        "overlapping",
        "unresolved_shoulder"
      ],
      "band_count": 2,
      "ratio_count": 2,
      "usable_ratio_count": 1
    }
  ]
}
